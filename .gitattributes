# Keep LF line endings in the repository; shell scripts must stay LF to run on Linux/macOS.
* text=auto eol=lf
*.sh text eol=lf
*.png binary
*.ico binary
*.jpg binary
*.mp4 binary
# impeccable's Windows launcher: cmd.exe parses batch files by byte offset, so an LF-only .cmd breaks its goto / call.
packages/core/bundled/impeccable/**/*.cmd text eol=crlf
